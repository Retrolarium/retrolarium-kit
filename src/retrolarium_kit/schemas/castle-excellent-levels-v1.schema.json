{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrolarium.local/schemas/castle-levels-v1.schema.json",
  "title": "Retrolarium Castle level document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "game",
    "revision",
    "source_sha256",
    "width",
    "height",
    "rooms"
  ],
  "properties": {
    "schema": {"const": "retrolarium.castle-levels"},
    "schema_version": {"const": 1},
    "game": {"$ref": "#/$defs/identifier"},
    "revision": {"$ref": "#/$defs/identifier"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/room"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "byte": {"type": "integer", "minimum": 0, "maximum": 255},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoded_type", "x", "y"],
      "properties": {
        "encoded_type": {"$ref": "#/$defs/byte"},
        "x": {"$ref": "#/$defs/byte"},
        "y": {"$ref": "#/$defs/byte"}
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "cells", "objects"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/byte"}
          }
        },
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/object"}
        }
      }
    }
  }
}
