{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrolarium.local/schemas/castle-excellent-levels-v1.schema.json",
  "title": "Retrolarium Castle Excellent level document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "game",
    "revision",
    "source_sha256",
    "width",
    "height",
    "rooms"
  ],
  "properties": {
    "schema": {"const": "retrolarium.castle-excellent-levels"},
    "schema_version": {"const": 1},
    "game": {"$ref": "#/$defs/identifier"},
    "revision": {"$ref": "#/$defs/identifier"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/room"}
    },
    "rendering": {"$ref": "#/$defs/rendering"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "byte": {"type": "integer", "minimum": 0, "maximum": 255},
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec", "chr_bank", "chr_2bpp", "room_palette", "left_tiles",
        "right_tiles", "cell_attributes", "initial_attributes",
        "attribute_masks", "attribute_preserving_cells"
      ],
      "dependentRequired": {
        "runtime_object_types": ["metasprite_descriptors", "object_previews"],
        "metasprite_descriptors": ["runtime_object_types", "object_previews"],
        "object_previews": ["runtime_object_types", "metasprite_descriptors"]
      },
      "properties": {
        "codec": {"const": "castle-excellent.room-rendering.v1"},
        "chr_bank": {"type": "integer", "minimum": 0},
        "chr_2bpp": {"$ref": "#/$defs/chr_bank"},
        "room_palette": {"$ref": "#/$defs/palette_bytes"},
        "left_tiles": {"$ref": "#/$defs/cell_bytes"},
        "right_tiles": {"$ref": "#/$defs/cell_bytes"},
        "cell_attributes": {"$ref": "#/$defs/cell_bytes"},
        "initial_attributes": {"$ref": "#/$defs/initial_attribute_bytes"},
        "attribute_masks": {"$ref": "#/$defs/attribute_mask_bytes"},
        "attribute_preserving_cells": {
          "type": "array",
          "items": {"$ref": "#/$defs/byte"},
          "uniqueItems": true
        },
        "runtime_object_types": {
          "type": "array", "minItems": 61, "maxItems": 61,
          "items": {"$ref": "#/$defs/byte"}
        },
        "metasprite_descriptors": {
          "type": "array", "minItems": 406, "maxItems": 406,
          "items": {"$ref": "#/$defs/byte"}
        },
        "object_previews": {
          "type": "array",
          "items": {"$ref": "#/$defs/object_preview"}
        }
      }
    },
    "object_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_type", "descriptor_offset", "x_offsets"],
      "properties": {
        "runtime_type": {"$ref": "#/$defs/byte"},
        "descriptor_offset": {"type": "integer", "minimum": 0, "maximum": 405},
        "x_offsets": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {"$ref": "#/$defs/byte"}
        }
      }
    },
    "chr_bank": {
      "type": "array", "minItems": 8192, "maxItems": 8192,
      "items": {"$ref": "#/$defs/byte"}
    },
    "palette_bytes": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": {"$ref": "#/$defs/byte"}
    },
    "cell_bytes": {
      "type": "array", "minItems": 100, "maxItems": 100,
      "items": {"$ref": "#/$defs/byte"}
    },
    "initial_attribute_bytes": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {"$ref": "#/$defs/byte"}
    },
    "attribute_mask_bytes": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/byte"}
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoded_type", "x", "y"],
      "properties": {
        "encoded_type": {"$ref": "#/$defs/byte"},
        "x": {"$ref": "#/$defs/byte"},
        "y": {"$ref": "#/$defs/byte"}
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "cells", "objects"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/byte"}
          }
        },
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/object"}
        }
      }
    }
  }
}
