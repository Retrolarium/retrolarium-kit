{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrolarium.local/schemas/nes-resource-bundle-v1.schema.json",
  "title": "Retrolarium NES resource bundle document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "game",
    "revision",
    "source_sha256",
    "resources"
  ],
  "properties": {
    "schema": {"const": "retrolarium.nes-resource-bundle"},
    "schema_version": {"const": 1},
    "game": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "codec"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["screen", "palette", "graphics"]},
          "codec": {
            "enum": [
              "nes.nametable.v1",
              "nes.palette-table.v1",
              "nes.chr-2bpp.v1"
            ]
          },
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "tiles": {"type": "array"},
          "attributes": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0, "maximum": 255}
          },
          "values": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0, "maximum": 255}
          }
        }
      }
    }
  }
}
