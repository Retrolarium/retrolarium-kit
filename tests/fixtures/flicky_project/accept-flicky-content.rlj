schema = "retrolarium.project"
schema_version = 1

[project]
id = "flicky-ue"
name = "Flicky (UE)"
platform = "megadrive"
profile = "flicky-ue.v1"
source_mode = "flicky-content"

[source]
manifest = "flicky-source/retrolarium-flicky-snapshot.json"
sha256 = "4df1a91e08376ae773a6eb8e5abe310f94ca39d8f81583b91a9477fedcb68c11"

[workspace]
layout = "two-row"
startup_tab = "levels"

[[workspace.tabs]]
id = "levels"
title = "Levels"
kind = "flicky.levels"
group = "content"
codec = "flicky.levels.v1"
document = "flicky-source/content/workspace/level/levels.json"
capabilities = ["paint", "edit", "preview", "playtest", "navigate", "undo", "restore"]
depends_on = ["graphics", "semantics", "animations"]

[[workspace.tabs]]
id = "graphics"
title = "Graphics"
kind = "flicky.graphics"
group = "assets"
codec = "flicky.graphics.v1"
document = "flicky-source/content/workspace/graphics/graphics.json"
capabilities = ["paint", "navigate", "undo", "restore"]

[[workspace.tabs]]
id = "semantics"
title = "Palettes & Text"
kind = "flicky.semantics"
group = "assets"
codec = "flicky.semantics.v1"
document = "flicky-source/content/workspace/graphics/semantics.json"
capabilities = ["edit", "navigate", "undo", "restore"]

[[workspace.tabs]]
id = "animations"
title = "Animations"
kind = "flicky.animations"
group = "assets"
codec = "flicky.animations.v1"
document = "flicky-source/content/workspace/graphics/sequences.json"
capabilities = ["edit", "navigate", "undo", "restore"]

[[workspace.tabs]]
id = "sound"
title = "Music & Sound"
kind = "flicky.sound"
group = "content"
codec = "flicky.sound.v1"
document = "flicky-source/content/workspace/sound/z80_sound_data.asm"
capabilities = ["edit", "preview", "navigate", "undo", "restore"]

[operations]
validate = "project.validate"
build = "project.build"
verify = "project.verify"
launch = "project.launch"
